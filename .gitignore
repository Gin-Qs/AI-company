.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
data/real/
data/runlog/
data/facturacion/

# Secretos del portal. Nunca versionados: las llaves de Clerk y la cadena de
# Postgres viven aqui y solo aqui. Ver docs/portal.md §15.
.env
.env.*
!.env.example
web/.env
web/.env.*
!web/.env.example

# Next.js
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
web/out/
web/.vercel/

# Salida de scripts/validate_registry.py --json. La produce la CI en cada corrida.
validacion.json

# Herramientas de asistentes: configuracion local, no del proyecto. Sin esto, un
# `git add -A` las sube y quedan como si fueran parte del sistema.
.agents/
.codex/
.github/agents/
.github/hooks/
.github/skills/
skills-lock.json

# Espacio de trabajo temporal de herramientas. Nunca es codigo del proyecto, y un
# `git add -A` se traga node_modules enteros si no esta aqui.
tmp/
