# Plantilla de variables del portal de mando (docs/portal.md §15).
#
# COMO USARLA
#   1. Copia este archivo a web/.env.local
#   2. Pega ahi los valores reales
#   3. web/.env.local esta en .gitignore y NUNCA se sube al repositorio
#
# No pegues ninguno de estos valores en el chat. Un secreto compartido en una
# conversacion queda en el historial de la conversacion; uno en .env.local no.

# --- Postgres (Supabase) -----------------------------------------------------
# Dashboard de Supabase -> Project Settings -> Database -> Connection string
#
# Vercel ejecuta funciones serverless: cada invocacion abre su propia conexion y
# Postgres se queda sin cupo. Por eso son DOS cadenas y no una:
#
#   DATABASE_URL       el pooler (puerto 6543). Lo que usa la app en runtime.
#   DIRECT_URL         la conexion directa (puerto 5432). Solo para migraciones,
#                      porque el pooler no soporta las sentencias que Prisma emite
#                      al migrar.
# Proyecto: ai-company  (ref aaqrcgyskkdolupptkwi, region us-east-1)
# El esquema YA esta aplicado. Lo unico que falta aqui es TU CONTRASENA, que el
# conector no expone: Supabase -> Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.aaqrcgyskkdolupptkwi:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.aaqrcgyskkdolupptkwi:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Clerk -------------------------------------------------------------------
# Dashboard de Clerk -> API Keys. La aplicacion debe estar en modo restringido
# (invite-only), sin registro publico: docs/portal.md §7.4
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Rutas de Clerk. No hay pagina de registro a proposito: nadie se registra solo.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/entrar"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/resumen"
